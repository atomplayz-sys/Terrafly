# DepthWizard / TerraFly keeps source, docs, and small licensed fixtures in Git; machine-specific cache stays local.

# Environments & Virtual Environments
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg
*.egg-info/
backend/*.egg-info/
backend/terrafly.egg-info/

# Testing & Linting
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Frontend Node & Build Caches
frontend/node_modules/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
*.tsbuildinfo
frontend/*.tsbuildinfo

# Local Data, Runtime & Heavy Deep Learning Weights (Never commit gigabytes of weights to Git)
runtime/
jobs/
outputs/
data/
models/
checkpoints/
.cache/
*.safetensors
*.pt
*.pth
*.ckpt

# Binaries & Executables
*.exe
cloudflared*

# Secrets & Environment Variables
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json

# Archives & Temporary Files
*.zip
*.tar.gz
*.log
*.tmp
*.bak

# OS & IDE Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.user
